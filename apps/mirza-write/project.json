{
  "name": "mirza-write",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/mirza-write/src",
  "tags": ["scope:mirza-app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/mirza-write",
        "index": "apps/mirza-write/src/index.html",
        "browser": "apps/mirza-write/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/mirza-write/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/mirza-write/public"
          },
          {
            "glob": "**/*",
            "input": "libs/mirza/assets/src",
            "output": "assets"
          },
          {
            "glob": "**/*",
            "input": "libs/shared/assets/src",
            "output": "assets"
          },
          {
            "glob": "**/*",
            "input": "libs/shared/services/splash-screen/src/lib/assets",
            "output": "assets"
          }
        ],
        "styles": [
          "libs/mirza/styles/src/themes.scss",
          "libs/shared/styles/src/module.css",
          "apps/mirza-write/src/styles.css"
        ],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/shared/styles/src"]
        },
        "scripts": [],
        "allowedCommonJsDependencies": ["flat"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "3mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "20kb",
              "maximumError": "40kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/mirza-write/src/environments/environment.ts",
              "with": "apps/mirza-write/src/environments/environment.production.ts"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "apps/mirza-write/ngsw-config.json"
        },
        "stage": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "3mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "20kb",
              "maximumError": "40kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/mirza-write/src/environments/environment.ts",
              "with": "apps/mirza-write/src/environments/environment.stage.ts"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "apps/mirza-write/ngsw-config.json"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 5300
      },
      "configurations": {
        "production": {
          "buildTarget": "mirza-write:build:production"
        },
        "development": {
          "buildTarget": "mirza-write:build:development"
        }
      },
      "readyWhen": {
        "signal": true
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "mirza-write:build"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "mirza-write:build",
        "port": 5300,
        "staticFilePath": "dist/apps/mirza-write/browser",
        "spa": true
      }
    }
  }
}
